#!/bin/sh
# Nine checks before a commit, enabled per clone with `git config core.hooksPath .githooks`:
#
# - issues/INDEX.md and issues/OPEN.md are kept in step with the issue files: whenever something in
#   issues/ is part of a commit, both are generated from the issue files as they are staged and
#   added to the commit. An issue file whose fields are missing or unknown refuses the commit.
# - Rust code is laid out by rustfmt (docs/CODING-GUIDELINES.md): whenever Rust code is part of a
#   commit, or rustfmt.toml, `cargo fmt --all --check` must pass, or the commit is refused. It
#   checks the working tree, as clippy does.
# - Clippy stays silent (docs/CODING-GUIDELINES.md): whenever Rust code, a Cargo manifest or
#   clippy.toml is part of a commit, `cargo clippy --workspace --all-targets -- -D warnings` must
#   pass, or the commit is refused. It checks the working tree, so changes that are not staged
#   count too.
# - Prose is wrapped by the rules of docs/CODING-GUIDELINES.md: `scripts/wrapping.sh` must find no
#   line too long, and none beginning with a dash, in the Markdown, Rust and TypeScript files a
#   commit adds or changes, read whole from the working tree; files the commit leaves out are not
#   checked.
# - Tuple bindings stay on one line (docs/CODING-GUIDELINES.md, "Small return values"):
#   `scripts/tuple-bindings.sh` must find none longer than 100 characters or across lines in the
#   Rust files a commit adds or changes, read whole from the working tree.
# - A module's `mod` declarations, re-exports and imports stand in this order, the imports in one
#   block (docs/CODING-GUIDELINES.md, "Imports"): `scripts/import-blocks.sh` must find none out of
#   order and no split block in the Rust files a commit adds or changes, read whole from the
#   working tree.
# - A library links no kernel (issue 516): whenever a Cargo manifest is part of a commit,
#   `scripts/library-deps.sh` must find neither a library nor the library side of a crate that
#   stands on both levels with `caelumora-kernel` among its normal dependencies, nor `caelumora-api`
#   with a crate of Caelumora but the model.
# - A library names nothing only the kernel may decide by that the model still offers
#   (docs/ARCHITECTURE.md, "The kernel decides, the agent side asks"): `scripts/library-names.sh`
#   must find no `SecurityContext`, policy, manager or store of the model in the code of the
#   libraries' Rust files a commit adds or changes, read whole from the working tree.
# - The crates that stand on both levels stay cut (issue 516): whenever Rust code or a Cargo
#   manifest is part of a commit, the crates of `scripts/libraries.sh` that stand on both levels
#   must build without features - what a client reads -, with the feature `library` alone - the
#   agent side without the plugin - and with `kernel` alone - the plugin without the agents.
#
# `git commit --no-verify` skips all nine.
set -eu

. scripts/libraries.sh

if ! git diff --cached --quiet -- issues/; then
    staged=$(mktemp -d)
    trap 'rm -rf "$staged"' EXIT
    git ls-files -- 'issues/[0-9]*.md' | git checkout-index --prefix="$staged/" --stdin
    issues/generate.sh "$staged/issues"
    git add issues/INDEX.md issues/OPEN.md
fi

if ! git diff --cached --quiet -- '*.rs' rustfmt.toml; then
    cargo fmt --all --check
fi

if ! git diff --cached --quiet -- '*.rs' '*Cargo.toml' Cargo.lock clippy.toml; then
    cargo clippy --workspace --all-targets --quiet -- -D warnings
fi

if ! git diff --cached --quiet -- '*Cargo.toml' Cargo.lock; then
    scripts/library-deps.sh
fi

if ! git diff --cached --quiet -- '*.rs' '*Cargo.toml' Cargo.lock; then
    for crate in $both_levels; do
        cargo check --quiet -p "$crate" --no-default-features
        for side in library kernel; do
            cargo check --quiet -p "$crate" --no-default-features --features "$side"
        done
    done
fi

committed=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md' '*.rs' '*.ts' '*.tsx')
if [ -n "$committed" ]; then
    scripts/wrapping.sh $committed
fi

rust=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
if [ -n "$rust" ]; then
    scripts/tuple-bindings.sh $rust
    scripts/import-blocks.sh $rust
    scripts/library-names.sh $rust
fi
